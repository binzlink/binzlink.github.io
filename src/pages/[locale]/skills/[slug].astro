---
import DetailPage from '../../../components/DetailPage.astro';
import { itemsByType } from '../../../lib/catalog';
import { localeItemPaths } from '../../../lib/locales';

export async function getStaticPaths() {
  return localeItemPaths(await itemsByType('skill'));
}

const { item, locale } = Astro.props;
---

<DetailPage locale={locale} item={item} />
