---
import DetailPage from '../../../components/DetailPage.astro';
import { itemsByType } from '../../../lib/catalog';

export async function getStaticPaths() {
  const items = await itemsByType('plugin');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
---

<DetailPage locale="zh" item={item} />
