---
import '../styles/global.css';
import ShareBar from '../components/ShareBar.astro';
import { ui } from '../lib/i18n';
import {
  LOCALES,
  localeMeta,
  locPath,
  switchLocaleHref,
  type Locale,
} from '../lib/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;
const t = ui(locale);
const meta = localeMeta(locale);
const canonical = new URL(path, Astro.site).href;
const enHref = new URL(switchLocaleHref(path, locale, 'en'), Astro.site).href;
const ogImage = new URL('/apple-touch-icon.png', Astro.site).href;
---

<!doctype html>
<html lang={meta.html} dir={meta.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link
        rel="alternate"
        hreflang={l.hreflang}
        href={new URL(switchLocaleHref(path, locale, l.id), Astro.site).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#101114" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ClaudeNovo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.html.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={locPath('/', locale)}>{t.brand}</a>
        <div class="header-end">
          <nav>
            <a href={locPath('/plugins/', locale)}>{t.navPlugins}</a>
            <a href={locPath('/skills/', locale)}>{t.navSkills}</a>
            <a href={locPath('/mcp/', locale)}>{t.navMcp}</a>
            <a href={locPath('/guides/skills-vs-mcp-vs-plugins/', locale)}>{t.navGuide}</a>
            <a href={locPath('/contact/', locale)}>{t.navContact}</a>
          </nav>
          <details class="lang-switch">
            <summary>{meta.native}</summary>
            <ul>
              {LOCALES.map((l) => (
                <li>
                  <a
                    href={switchLocaleHref(path, locale, l.id)}
                    hreflang={l.hreflang}
                    lang={l.html}
                    aria-current={l.id === locale ? 'true' : undefined}
                  >
                    {l.native}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{t.independent}</span>
        <span>
          <a href={locPath('/memcard/', locale)}>CardMem</a>
          ·
          <a href={locPath('/contact/', locale)}>{t.navContact}</a>
          ·
          <a href={locPath('/privacy-policy/', locale)}>{t.privacy}</a>
        </span>
      </div>
      <div class="wrap">
        <ShareBar locale={locale} title={title} description={description} url={canonical} />
      </div>
    </footer>
  </body>
</html>
