---
import Base from '../layouts/Base.astro';
import { locPath, type Locale } from '../lib/catalog';
import { ui } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui(locale);
const p = copy.privacyPage;
const path = locPath('/privacy-policy/', locale);
const updated = '2026-08-13';
const email = 'support@claudenovo.com';
---

<Base locale={locale} title={`${copy.privacy} — ClaudeNovo`} description={copy.privacy} path={path}>
  <article class="wrap prose">
    <h1>{copy.privacy}</h1>
    <p>{p.updated}: {updated}</p>
    <p>{p.intro}</p>
    <h2>{p.collectH}</h2>
    <p>{p.collectP1}</p>
    <p>{p.collectP2}</p>
    <h2>{p.cookieH}</h2>
    <p>{p.cookieP}</p>
    <h2>{p.thirdH}</h2>
    <p>{p.thirdP}</p>
    <h2>{p.contactH}</h2>
    <p>
      {p.contactLead}
      {' '}
      <a href={`mailto:${email}`}>{email}</a>.
      {' '}
      {p.see}
      {' '}
      <a href={locPath('/contact/', locale)}>{copy.navContact}</a>.
    </p>
  </article>
</Base>
