---
import type { Locale } from '../lib/catalog';
import { ui } from '../lib/i18n';

interface Props {
  status: 'works' | 'broken' | 'unverified';
  locale: Locale;
}

const { status, locale } = Astro.props;
if (status === 'unverified') return;
const copy = ui(locale);
const label = {
  works: copy.statusWorks,
  broken: copy.statusBroken,
}[status];
---

<span class={`badge ${status}`}>{label}</span>
