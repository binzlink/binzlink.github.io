---
import Base from '../layouts/Base.astro';
import { locPath, type Locale } from '../lib/catalog';
import { ui } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui(locale);
const g = copy.guide;
const path = locPath('/guides/skills-vs-mcp-vs-plugins/', locale);
---

<Base locale={locale} title={`${copy.guideTitle} — ClaudeNovo`} description={copy.guideLead} path={path}>
  <article class="wrap prose">
    <h1>{copy.guideTitle}</h1>
    <p>{g.intro}</p>

    <h2>{g.skillH}</h2>
    <p>{g.skillP1}</p>
    <p>{g.skillP2}</p>

    <h2>{g.mcpH}</h2>
    <p>{g.mcpP1}</p>
    <p>{g.mcpP2}</p>
    <p>{g.mcpP3}</p>

    <h2>{g.pluginH}</h2>
    <p>{g.pluginP1}</p>
    <p>{g.pluginP2}</p>

    <h2>{g.chooseH}</h2>
    <ul>
      {g.choose.map((item) => <li>{item}</li>)}
    </ul>
    <p>{g.split}</p>
    <p>{g.jobNote}</p>
  </article>
</Base>
