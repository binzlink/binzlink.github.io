---
import Base from '../layouts/Base.astro';
import JsonLd from './JsonLd.astro';
import { locPath, type Locale } from '../lib/catalog';
import { ui } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui(locale);
const g = copy.guide;
const path = locPath('/guides/skills-vs-mcp-vs-plugins/', locale);
const title = `${copy.guideTitle} | Claude Code | ClaudeNovo`;
---

<Base locale={locale} title={title} description={copy.guideLead} path={path}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: g.skillH,
          acceptedAnswer: { '@type': 'Answer', text: `${g.skillP1} ${g.skillP2}` },
        },
        {
          '@type': 'Question',
          name: g.mcpH,
          acceptedAnswer: { '@type': 'Answer', text: `${g.mcpP1} ${g.mcpP2}` },
        },
        {
          '@type': 'Question',
          name: g.pluginH,
          acceptedAnswer: { '@type': 'Answer', text: `${g.pluginP1} ${g.pluginP2}` },
        },
        {
          '@type': 'Question',
          name: g.chooseH,
          acceptedAnswer: { '@type': 'Answer', text: g.choose.join(' ') },
        },
      ],
    }}
  />
  <article class="wrap prose">
    <h1>{copy.guideTitle}</h1>
    <p>{g.intro}</p>

    <h2>{g.skillH}</h2>
    <p>{g.skillP1}</p>
    <p>{g.skillP2}</p>

    <h2>{g.mcpH}</h2>
    <p>{g.mcpP1}</p>
    <p>{g.mcpP2}</p>
    <p>{g.mcpP3}</p>

    <h2>{g.pluginH}</h2>
    <p>{g.pluginP1}</p>
    <p>{g.pluginP2}</p>

    <h2>{g.chooseH}</h2>
    <ul>
      {g.choose.map((item) => <li>{item}</li>)}
    </ul>
    <p>{g.split}</p>
    <p>{g.jobNote}</p>
  </article>
</Base>
