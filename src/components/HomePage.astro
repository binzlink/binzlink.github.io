---
import Base from '../layouts/Base.astro';
import CatalogSearch from './CatalogSearch.astro';
import ItemCard from './ItemCard.astro';
import { locPath, type CatalogItem, type Locale } from '../lib/catalog';
import { formatCount, ui } from '../lib/i18n';

interface Props {
  locale: Locale;
  featured: CatalogItem[];
  items: CatalogItem[];
}

const { locale, featured, items } = Astro.props;
const copy = ui(locale);
const path = locPath('/', locale);
---

<Base locale={locale} title={`ClaudeNovo — ${copy.tagline}`} description={copy.tagline} path={path}>
  <div class="wrap">
    <section class="hero">
      <h1>{copy.tagline}</h1>
      <p class="lead">{copy.trustNote}</p>
      <p class="disclaimer">{copy.independent}</p>
      <p class="hero-actions">
        <a class="btn" href={locPath('/contact/', locale)}>{copy.navContact}</a>
      </p>
    </section>

    <CatalogSearch locale={locale} />

    <p class="section-title">{copy.featured}</p>
    <div class="grid">
      {featured.map((item) => <ItemCard item={item} locale={locale} />)}
    </div>

    <p class="section-title">{copy.all} · {formatCount(locale, items.length)}</p>
    <p id="search-empty" class="hint hidden">{copy.searchEmpty}</p>
    <div class="grid">
      {items.map((item) => <ItemCard item={item} locale={locale} />)}
    </div>
  </div>
</Base>
